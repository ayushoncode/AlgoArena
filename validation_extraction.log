import java.util.*;
import java.util.stream.*;
import java.lang.reflect.*;
class Solution {
    public long solution(int[] packets) {
        int n = packets.length + 2;
        int[] nums = new int[n];
        nums[0] = nums[n - 1] = 1;
        for (int i = 0; i < packets.length; i++) nums[i + 1] = packets[i];
        long[][] dp = new long[n][n];
        for (int length = 2; length < n; length++) {
            for (int left = 0; left < n - length; left++) {
                int right = left + length;
                for (int i = left + 1; i < right; i++) {
                    dp[left][right] = Math.max(dp[left][right], (long)nums[left] * nums[right] + nums[i] + dp[left][i] + dp[i][right]);
                }
            }
        }
        return dp[0][n - 1];
    }
}
