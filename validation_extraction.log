def solution(packets):
    def dfs(nums):
        if not nums: return 0
        ans = 0
        for i in range(len(nums)):
            l = nums[i-1] if i > 0 else 1
            r = nums[i+1] if i < len(nums)-1 else 1
            ans = max(ans, l * r + nums[i] + dfs(nums[:i] + nums[i+1:]))
        return ans
    return dfs(packets)
