def solution(intervals):
    if not intervals: return []
    # O(N^2) naive graph components approach
    n = len(intervals)
    adj = {i: [] for i in range(n)}
    for i in range(n):
        for j in range(i + 1, n):
            if max(intervals[i][0], intervals[j][0]) <= min(intervals[i][1], intervals[j][1]):
                adj[i].append(j)
                adj[j].append(i)
    visited = set()
    res = []
    for i in range(n):
        if i not in visited:
            comp_start, comp_end = intervals[i]
            q = [i]
            visited.add(i)
            while q:
                curr = q.pop(0)
                comp_start = min(comp_start, intervals[curr][0])
                comp_end = max(comp_end, intervals[curr][1])
                for nxt in adj[curr]:
                    if nxt not in visited:
                        visited.add(nxt)
                        q.append(nxt)
            res.append([comp_start, comp_end])
    res.sort(key=lambda x: x[0])
    return res
