# ── AlgoArena Backend Environment Configuration Example ───────

# Server
PORT=4000
NODE_ENV=development

# PostgreSQL Database URL
DATABASE_URL=postgres://user:password@localhost:5432/algoarena

# JWT Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Frontend Origin (CORS)
CLIENT_URL=http://localhost:5173

# Redis / BullMQ submission queue
REDIS_URL=redis://localhost:6379

# Firebase Project
FIREBASE_PROJECT_ID=your_firebase_project_id

# Email (SMTP)
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="AlgoArena <no-reply@algoarena.io>"

# ── Premium Feature Flags (defaults off) ────────────────────────
PREMIUM_ENABLED=false
PREMIUM_GATING_ENABLED=false

# ── Razorpay Configuration (TEST MODE ONLY in dev) ──────────────
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret_never_commit
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
RAZORPAY_PLAN_LAUNCH_ID=plan_launch_test
RAZORPAY_PLAN_STANDARD_ID=plan_standard_test

