function solution(nums, target) {
    const find = (isFirst) => {
        let ans = -1, l = 0, r = nums.length - 1;
        while (l <= r) {
            let mid = (l + r) >> 1;
            if (nums[mid] === target) {
                ans = mid;
                if (isFirst) r = mid - 1;
                else l = mid + 1;
            } else if (nums[mid] < target) l = mid + 1;
            else r = mid - 1;
        }
        return ans;
    };
    return [find(true), find(false)];
}
