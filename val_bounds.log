#include <vector>
using namespace std;
class Solution {
    int find(vector<int>& nums, int target, bool isFirst) {
        int ans = -1, l = 0, r = nums.size() - 1;
        while (l <= r) {
            int mid = l + (r - l) / 2;
            if (nums[mid] == target) {
                ans = mid;
                if (isFirst) r = mid - 1;
                else l = mid + 1;
            } else if (nums[mid] < target) l = mid + 1;
            else r = mid - 1;
        }
        return ans;
    }
public:
    vector<int> solution(vector<int>& nums, int target) {
        return {find(nums, target, true), find(nums, target, false)};
    }
};
