# ── AlgoArena Workers ──────────────────────────────────────────────

# Redis (Upstash) — get from https://upstash.com
REDIS_URL=rediss://your-upstash-url-here

# PostgreSQL (same Supabase URL as backend)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Environment
NODE_ENV=development

# Docker image name (built from workers/Dockerfile.sandbox)
SANDBOX_IMAGE=algoarena-sandbox

# Sandbox hard timeout in ms (Docker-level kill + node backup)
SANDBOX_TIMEOUT_MS=5000

# How many jobs to process in parallel
WORKER_CONCURRENCY=3
