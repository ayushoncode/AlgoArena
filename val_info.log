import heapq
def solution(edges, n, startNode):
    adj = {i: [] for i in range(1, n + 1)}
    for u, v, w in edges:
        adj[u].append((v, w))
    dist = {i: float('inf') for i in range(1, n + 1)}
    dist[startNode] = 0
    pq = [(0, startNode)]
    while pq:
        d, u = heapq.heappop(pq)
        if d > dist[u]: continue
        for v, w in adj[u]:
            if dist[u] + w < dist[v]:
                dist[v] = dist[u] + w
                heapq.heappush(pq, (dist[v], v))
    ans = max(dist.values())
    return ans if ans != float('inf') else -1
