#include <vector>
#include <queue>
#include <algorithm>
using namespace std;
class Solution {
public:
    int solution(vector<vector<int>>& edges, int n, int startNode) {
        vector<vector<pair<int, int>>> adj(n + 1);
        for (auto& e : edges) {
            adj[e[0]].push_back({e[1], e[2]});
        }
        vector<int> dist(n + 1, 1e9);
        dist[startNode] = 0;
        priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> pq;
        pq.push({0, startNode});
        while (!pq.empty()) {
            auto [d, u] = pq.top();
            pq.pop();
            if (d > dist[u]) continue;
            for (auto& next : adj[u]) {
                int v = next.first, w = next.second;
                if (dist[u] + w < dist[v]) {
                    dist[v] = dist[u] + w;
                    pq.push({dist[v], v});
                }
            }
        }
        int ans = 0;
        for (int i = 1; i <= n; i++) {
            if (dist[i] == 1e9) return -1;
            ans = max(ans, dist[i]);
        }
        return ans;
    }
};
