    for (let length = 2; length < n; length++) {
        for (let left = 0; left < n - length; left++) {
            let right = left + length;
            for (let i = left + 1; i < right; i++) {
                dp[left][right] = Math.max(dp[left][right], nums[left] * nums[i] * nums[right] + dp[left][i] + dp[i][right]);
            }
        }
    }
    return dp[0][n - 1];
}
