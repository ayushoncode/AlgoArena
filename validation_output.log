            pq.pop();
            if (d > dist[u]) continue;
            for (auto& next : adj[u]) {
                int v = next.first, w = next.second;
                if (dist[u] + w < dist[v]) {
                    dist[v] = dist[u] + w;
                    pq.push({dist[v], v});
